PORT=5000
DATABASE_URL=postgresql://user:pass@localhost:5432/opendesk
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars

# Platform M-Pesa (subscription payments — platform owner's credentials)
PLATFORM_MPESA_CONSUMER_KEY=your_platform_consumer_key
PLATFORM_MPESA_CONSUMER_SECRET=your_platform_consumer_secret
PLATFORM_MPESA_SHORTCODE=174379
PLATFORM_MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
PLATFORM_MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/platform-callback
PLATFORM_MPESA_ENVIRONMENT=sandbox

# Parcel M-Pesa callback (company credentials per company; stored encrypted in DB)
PARCEL_MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/parcel-callback

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Encryption for company M-Pesa credentials and sender ID numbers
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CREDENTIALS_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MPESA_CREDENTIALS_ENCRYPTION_IV=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

NODE_ENV=development
