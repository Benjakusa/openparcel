{
  "name": "opendesk-parcel-client",
  "version": "1.0.0",
  "description": "OpenDesk Parcel - Desktop Client for Parcel Tracking",
  "author": "OpenDesk Technologies",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder build --win --x64",
    "dist:msi": "electron-builder build --win msi --x64"
  },
  "build": {
    "appId": "com.opendesk.parcel-client",
    "productName": "OpenDesk Parcel",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": null,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "OpenDesk Technologies"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "OpenDesk",
      "perMachine": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  }
}
