{
  "name": "opendesk-parcel-client",
  "version": "1.0.0",
  "description": "OpenDesk Parcel - Desktop Client for Parcel Tracking",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder build --win --x64",
    "dist:msi": "electron-builder build --win msi --x64"
  },
  "build": {
    "appId": "com.opendesk.parcel-client",
    "productName": "OpenDesk Parcel",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "OpenDesk Technologies"
    },
    "msi": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "OpenDesk",
      "perMachine": true,
      "warningsAsErrors": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  }
}
